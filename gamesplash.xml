<theme>
   <formatVersion>7</formatVersion>
   <!-- Standalone native launch theme: Splash does not load theme.xml.
        Local defaults also handle an unset saved subset; these add no menu option. -->
   <subset name="color-scheme">
      <include name="default" />
   </subset>
   <subset name="distribution">
      <include name="batocera" />
   </subset>
   <variables>
      <distributionPath ifSubset="distribution:retrobat">~/.emulationstation/</distributionPath>
      <distributionPath ifSubset="distribution:batocera">/userdata/</distributionPath>
      <themeCustomizationsPath>${distributionPath}theme-customizations/art-book-next/</themeCustomizationsPath>
   </variables>
   <include>./colors.xml</include>
   <include ifSubset="color-scheme:custom">${themeCustomizationsPath}colors.xml</include>

   <view name="splash">
      <splash name="splash">
         <backgroundColor>${gamelistListBackgroundColor}</backgroundColor>
      </splash>
      <!-- Override the built-in screenshot with the selected game's logo. -->
      <image name="background">
         <path>{game:marquee}</path>
         <origin>0.5 0.5</origin>
         <pos>0.5 0.37</pos>
         <maxSize>0.78 0.40</maxSize>
         <roundCorners>0</roundCorners>
      </image>
      <!-- Native exists handles empty AND stale paths. Window supplies getName().
           An existing corrupt image is not detectable by theme expressions. -->
      <text name="label">
         <visible>!exists( {game:marquee} )</visible>
         <origin>0.5 0.5</origin>
         <pos>0.5 0.37</pos>
         <size>0.84 0.16</size>
         <fontPath>./_inc/fonts/Roboto-Bold.ttf</fontPath>
         <fontSize>0.05</fontSize>
         <color>${gamelistListDescriptionColor}</color>
         <alignment>center</alignment>
         <verticalAlignment>center</verticalAlignment>
         <forceUppercase>false</forceUppercase>
         <multiLine>true</multiLine>
      </text>
      <!-- Source system, not the enclosing collection/group. Unlisted systems
           intentionally have no hardware image. No generic/wrong-console fallback.
           Subdued alpha is intrinsic to the SVG: Splash resets component opacity. -->
      <image name="launchHardware" extra="true">
         <path>"${themePath}/_inc/launch-hardware/" + {game:system:name} + ".svg"</path>
         <origin>0.5 0.5</origin>
         <pos>0.5 0.73</pos>
         <maxSize>0.36 0.22</maxSize>
         <color>${gamelistListDescriptionColor}</color>
         <zIndex>6</zIndex>
      </image>
      <text name="launchStatus" extra="true">
         <text>LOADING…</text>
         <visible>true</visible>
         <origin>0.5 0.5</origin>
         <pos>0.5 0.89</pos>
         <size>0.6 0.06</size>
         <fontPath>./_inc/fonts/Roboto-Bold.ttf</fontPath>
         <fontSize>0.033333333333333</fontSize>
         <color>${gamelistListDescriptionColor}</color>
         <alignment>center</alignment>
         <verticalAlignment>center</verticalAlignment>
         <multiLine>false</multiLine>
         <zIndex>10</zIndex>
      </text>
      <!-- Launch has no measured progress. Hide both native bars explicitly. -->
      <image name="progressbar">
         <visible>false</visible>
      </image>
      <image name="progressbar:active">
         <visible>false</visible>
      </image>
   </view>
</theme>
